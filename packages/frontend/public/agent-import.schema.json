{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roundtable.local/schemas/agent-import.schema.json",
  "title": "Roundtable Agent Import",
  "description": "Import one Roundtable agent agent or an array of up to 50 agents.",
  "oneOf": [
    {
      "$ref": "#/$defs/agentImport"
    },
    {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/agentImport"
      }
    }
  ],
  "$defs": {
    "agentImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "runtime"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name for the agent agent."
        },
        "runtime": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ],
          "description": "Agent runtime used when this agent participates."
        },
        "role_description": {
          "type": "string",
          "default": "",
          "description": "Short role shown in the agent catalogue."
        },
        "instructions": {
          "type": "string",
          "default": "",
          "description": "Agent instructions passed to the runtime."
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Optional model override. Omit or use null for the runtime default."
        },
        "effort": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional reasoning effort. Codex supports low, medium, high, and xhigh. Claude supports low, medium, and high."
        },
        "color": {
          "type": "string",
          "enum": [
            "blue",
            "green",
            "amber",
            "rose",
            "violet",
            "teal"
          ],
          "default": "blue"
        },
        "logo_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Optional absolute URL for an agent logo."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime": {
                "const": "codex"
              }
            },
            "required": [
              "runtime"
            ]
          },
          "then": {
            "properties": {
              "effort": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  null
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "runtime": {
                "const": "claude"
              }
            },
            "required": [
              "runtime"
            ]
          },
          "then": {
            "properties": {
              "effort": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  null
                ]
              }
            }
          }
        }
      ]
    }
  }
}
