{
  "name": "roundtable",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"node scripts/wait-for-backend.mjs && npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace @roundtable/backend",
    "dev:frontend": "npm run dev --workspace @roundtable/frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
